-lake-id="u6732317a" id="u6732317a"><p data-lake-id="u466a0879" id="u466a0879" style="text-align: center"><span data-lake-id="ue32fe928" id="ue32fe928" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">H1-H6</span></p></td><td data-lake-id="u256980aa" id="u256980aa"><p data-lake-id="u099c2073" id="u099c2073" style="text-align: center"><span data-lake-id="udb21659c" id="udb21659c" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">Word中的1-6级标题样式</span></p></td></tr><tr data-lake-id="u31e3462c" id="u31e3462c"><td data-lake-id="ue8a8c680" id="ue8a8c680"><p data-lake-id="u94b9e6bf" id="u94b9e6bf" style="text-align: center"><span data-lake-id="ua40f1a8e" id="ua40f1a8e" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">内容块</span></p></td><td data-lake-id="u655bb806" id="u655bb806"><p data-lake-id="u6b8adf0f" id="u6b8adf0f" style="text-align: center"><span data-lake-id="u3e5748f8" id="u3e5748f8" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">文档中的最小语义单元</span></p></td></tr><tr data-lake-id="u494e86f3" id="u494e86f3"><td data-lake-id="uf672ab3e" id="uf672ab3e"><p data-lake-id="uc888afc2" id="uc888afc2" style="text-align: center"><span data-lake-id="uf9da089d" id="uf9da089d" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">outlinePath</span></p></td><td data-lake-id="uee5018fd" id="uee5018fd"><p data-lake-id="ubc2f235f" id="ubc2f235f" style="text-align: center"><span data-lake-id="ub5e891db" id="ub5e891db" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">标题路径（如&quot;1.2.3&quot;）</span></p></td></tr></tbody></table>