653cd" id="uf5c653cd"><td data-lake-id="u88718a8d" id="u88718a8d"><p data-lake-id="uada954f7" id="uada954f7" style="text-align: center"><span data-lake-id="ud3d0ba65" id="ud3d0ba65" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">表格</span></p></td><td data-lake-id="u19ef78bf" id="u19ef78bf"><p data-lake-id="u31b29d27" id="u31b29d27" style="text-align: center"><code data-lake-id="u1202c93b" id="u1202c93b"><span data-lake-id="u658c7e15" id="u658c7e15" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">[TABLE] {caption} \n 维度:{rows}x{cols}</span></code></p></td><td data-lake-id="ua6c7b553" id="ua6c7b553"><p data-lake-id="ucc1c3846" id="ucc1c3846" style="text-align: center"><span data-lake-id="u4f7eba2e" id="u4f7eba2e" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">1024</span></p></td></tr></tbody></table><h2 data-lake-id="fd1ae1b8" id="fd1ae1b8"><span data-lake-id="u4a8aef33" id="u4a8aef33" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">5. 异常处理方案</span></h2><h3 data-lake-id="96aca837" id="96aca837"><span data-lake-id="u58e114af" id="u58e114af" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">5.1 常见问题处理</span></h3><table data-lake-id="IYZK7" id="IYZK7" class="lake-table" style="width: 750px"><colgroup><col width="375"><col width="375"></colgroup><tbody><tr data-lake-id="ud3e31116" id="ud3e31116"><td data-lake-id="u5e3f390b" id="u5e3f390b" style="background-color: rgb(237, 237, 237)"><p data-lake-id="u8c3a11b3" id="u8c3a11b3" style="text-align: center"><span data-lake-id="ubdfe0569" id="ubdfe0569" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">问题场景</span></p></td><td data-lake-id="u9fa55877" id="u9fa55877" style="background-color: rgb(237, 237, 237)"><p data-lake-id="ub352f109" id="ub352f109" style="text-align: center"><span data-lake-id="u4dfb4cc3" id="u4dfb4cc3" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">解决方案</span></p></td></tr><tr data-lake-id="ud75e9f59" id="ud75e9f59"><td data-lake-id="uba114cb1" id="uba114cb1"><p data-lake-id="u7afbf6bb" id="u7afbf6bb" style="text-align: center"><span data-lake-id="ue405c0c6" id="ue405c0c6" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">标题层级跳跃</span></p></td><td data-lake-id="ub65caf9a" id="ub65caf9a"><p data-lake-id="u3892707f" id="u3892707f" style="text-align: center"><span data-lake-id="ub13b5e62" id="ub13b5e62" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">自动补全中间层级</span></p></td></tr><tr data-lake-id="u7f0cac74" id="u7f0cac74"><td data-lake-id="u7b325a3a" id="u7b325a3a"><p data-lake-id="u4cc78676" id="u4cc78676" style="text-align: center"><span data-lake-id="u2cf3c405" id="u2cf3c405" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">游离内容</span></p></td><td data-lake-id="u190b61f5" id="u190b61f5"><p data-lake-id="ubc0bde8a" id="ubc0bde8a" style="text-align: center"><span data-lake-id="u38a606f6" id="u38a606f6" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">创建&quot;未分类&quot;章节</span></p></td></tr><tr data-lake-id="ubbbb9fa2" id="ubbbb9fa2"><td data-lake-id="ucd74ed96" id="ucd74ed96"><p data-lake-id="u98b00573" id="u98b00573" style="text-align: center"><span data-lake-id="uef61a786" id="uef61a786" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">跨页表格</span></p></td><td data-lake-id="ubf25b7ed" id="ubf25b7ed"><p data-lake-id="u7015ac0f" id="u7015ac0f" style="text-align: center"><span data-lake-id="u1a022c69" id="u1a022c69" class="lake-fontsize-1515" style="color: rgba(0, 0, 0, 0.9); background-color: rgb(252, 252, 252)">拆分为主块+关联块</span></